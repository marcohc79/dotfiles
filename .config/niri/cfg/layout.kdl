layout {
    gaps 16 // Gap between windows
    center-focused-column "never" // Don't auto-center focused column

    background-color "transparent" // <- needed for noctalia-shell to set wallpaper

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    focus-ring {
        width 2.5
        active-color   "#ebbcba"
        inactive-color "#191724"
        urgent-color   "#eb6f92"
    }

    border {
        active-color   "#ebbcba"
        inactive-color "#191724"
        urgent-color   "#eb6f92"
    }

    shadow {
        color "#19172470"
    }

    tab-indicator {
        active-color   "#ebbcba"
        inactive-color "#ce2b24"
        urgent-color   "#eb6f92"
    }

    insert-hint {
        color "#ebbcba80"
    }

    struts {}
}
